target triple = "x86_64-pc-linux-gnu"

declare i32 @read()

declare void @print(i32 %0)

define i32 @func(i32 %0) {
entryBB:
  %a = alloca i32, align 4
  %b = alloca i32, align 4
  %c = alloca i32, align 4
  %d = alloca i32, align 4
  %i = alloca i32, align 4
  %return = alloca i32, align 4
  store i32 %0, ptr %i, align 4
  store i32 10, ptr %a, align 4
  store i32 20, ptr %b, align 4
  %1 = load i32, ptr %a, align 4
  %2 = add i32 %1, 10
  store i32 %2, ptr %c, align 4
  store i32 5, ptr %a, align 4
  br label %condBB

retBB:                                            ; preds = %falseBB
  %3 = load i32, ptr %return, align 4
  ret i32 %3

condBB:                                           ; preds = %endBB, %entryBB
  %4 = load i32, ptr %a, align 4
  %5 = load i32, ptr %i, align 4
  %6 = icmp slt i32 %4, %5
  br i1 %6, label %trueBB, label %falseBB

trueBB:                                           ; preds = %condBB
  %7 = load i32, ptr %a, align 4
  %8 = add i32 %7, 1
  store i32 %8, ptr %a, align 4
  %9 = load i32, ptr %a, align 4
  %10 = load i32, ptr %b, align 4
  %11 = icmp sgt i32 %9, %10
  br i1 %11, label %trueBB1, label %falseBB2

falseBB:                                          ; preds = %condBB
  %12 = load i32, ptr %a, align 4
  call void @print(i32 %12)
  %13 = load i32, ptr %b, align 4
  call void @print(i32 %13)
  %14 = load i32, ptr %c, align 4
  call void @print(i32 %14)
  %15 = load i32, ptr %b, align 4
  %16 = load i32, ptr %c, align 4
  %17 = add i32 %15, %16
  store i32 %17, ptr %return, align 4
  br label %retBB

trueBB1:                                          ; preds = %trueBB
  store i32 25, ptr %c, align 4
  br label %endBB

falseBB2:                                         ; preds = %trueBB
  store i32 25, ptr %c, align 4
  br label %endBB

endBB:                                            ; preds = %falseBB2, %trueBB1
  br label %condBB
}
