target triple = "x86_64-pc-linux-gnu"

declare i32 @read()

declare void @print(i32 %0)

define i32 @func() {
entryBB:
  %area = alloca i32, align 4
  %double_length = alloca i32, align 4
  %double_width = alloca i32, align 4
  %length = alloca i32, align 4
  %perimeter = alloca i32, align 4
  %width = alloca i32, align 4
  %return = alloca i32, align 4
  %0 = call i32 @read()
  store i32 %0, ptr %width, align 4
  %1 = call i32 @read()
  store i32 %1, ptr %length, align 4
  %2 = load i32, ptr %width, align 4
  %3 = load i32, ptr %length, align 4
  %4 = mul i32 %2, %3
  store i32 %4, ptr %area, align 4
  %5 = load i32, ptr %length, align 4
  %6 = load i32, ptr %length, align 4
  %7 = add i32 %5, %6
  store i32 %7, ptr %double_length, align 4
  %8 = load i32, ptr %width, align 4
  %9 = load i32, ptr %width, align 4
  %10 = add i32 %8, %9
  store i32 %10, ptr %double_width, align 4
  %11 = load i32, ptr %double_length, align 4
  %12 = load i32, ptr %double_width, align 4
  %13 = add i32 %11, %12
  store i32 %13, ptr %perimeter, align 4
  %14 = load i32, ptr %area, align 4
  call void @print(i32 %14)
  %15 = load i32, ptr %perimeter, align 4
  call void @print(i32 %15)
  store i32 0, ptr %return, align 4
  br label %retBB

retBB:                                            ; preds = %entryBB
  %16 = load i32, ptr %return, align 4
  ret i32 %16
}
doing 
doing done 

